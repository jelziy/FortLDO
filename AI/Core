    PlayerExiting(Agent:agent):void=(
         if(Red.Player = option{Agent} and GameStarted = true): #in this case gamestarted will always be true, because the if the agent has joined the game has started as it only requires one player.
            set Red.Player = false
            spawn{LeaveWidget(Agent)}           
            Red.Device.Camera.RemoveFrom(Agent)
            Red.Device.Camera.Disable()
            Red.Device.Chair.EnableExit()
            if(Red.Pns.Pawn.TeleportTo[Red.PawnInitialTransform]):
            if(Red.Pns.PawnOne.TeleportTo[Red.PawnOneInitialTransform]): 
            if(Red.Pns.PawnTwo.TeleportTo[Red.PawnTwoInitialTransform]): 
            if(Red.Pns.PawnThree.TeleportTo[Red.PawnThreeInitialTransform]):
            AllRedPawn : []creative_prop = Red.GetPawn()
