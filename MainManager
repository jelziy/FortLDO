        set RedPawnOneInitialTransform = RedPawnOne.GetTransform()
        set RedPawnTwoInitialTransform = RedPawnTwo.GetTransform()
        set RedPawnThreeInitialTransform = RedPawnThree.GetTransform()

        set AllPlayersPawns = array{RedPawn, RedPawnOne, RedPawnTwo, RedPawnThree}
        for(PlayerPawn : AllPlayersPawns):
            PlayerPawn.Hide()
        RedButton.InteractedWithEvent.Subscribe(RedOneJoined)
        BlueButton.InteractedWithEvent.Subscribe(BlueOneJoined)
        GreenButton.InteractedWithEvent.Subscribe(GreenOneJoined)
        YellowButton.InteractedWithEvent.Subscribe(YellowOneJoined)

        SelectZero.PressedEvent.Subscribe(SelectZeroPressed)
        SelectOne.PressedEvent.Subscribe(SelectOnePressed)
        SelectTwo.PressedEvent.Subscribe(SelectTwoPressed)
        SelectThree.PressedEvent.Subscribe(SelectThreePressed)
        ConfirmInput.PressedEvent.Subscribe(ConfirmInputPressed)
        DiceRoll.PressedEvent.Subscribe(DiceRollPressed)
    )

