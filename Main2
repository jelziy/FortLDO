    MovePawnRed(Pawn:creative_prop, Index:int, Agent:agent)<suspends>:void= (
        var CurrentIndex : int = Index
        PawnTransform := Pawn.GetTransform()
        PawnZ := PawnTransform.Translation.Z
        var WhichPawn : int = -1

        if(CurrentIndex = -1 and RedDiceRollValue = 6):
            if(Path := RedPaths[0]):
                PathTransform:= Path.GetTransform()
                PathTranslation:= PathTransform.Translation
                NewPos := vector3{X := PathTranslation.X, Y := PathTranslation.Y, Z := PawnZ}
                if(Pawn.TeleportTo[NewPos, PawnTransform.Rotation]):
                    APMove.Play()
                    set CurrentIndex = 0
                    set RedConsecutiveSixes += 1
                    if(RedConsecutiveSixes >= 3):
                        set RedPlayerTurn = false
                        set BluePlayerTurn = true
                        set RedConsecutiveSixes = 0
                    # else keep turn
                    set RedDiceRollValue = 0

        else if(CurrentIndex >= 0):
            Print("Stepwise movement, starting at index {CurrentIndex}")
            TargetIndex := CurrentIndex + RedDiceRollValue
            RemainingPaths := RedPaths.Length - CurrentIndex - 1
            if(RedDiceRollValue <= RemainingPaths):
                if(TargetIndex < RedPaths.Length):
                    for (Step := 1..RedDiceRollValue):
                        NextIndex := CurrentIndex + Step
                        Print("Step {Step}: NextIndex = {NextIndex}")
                        if(Path := RedPaths[NextIndex]):
                            PathTransform := Path.GetTransform()
                            PathTranslation := PathTransform.Translation
                            NewPos := vector3{X := PathTranslation.X, Y := PathTranslation.Y, Z := PawnZ}
                            if(Pawn.TeleportTo[NewPos, PawnTransform.Rotation]):
                                APMove.Play()
                                Sleep(0.4)
                    set CurrentIndex = TargetIndex
                    if(RedDiceRollValue = 6):
                        set RedConsecutiveSixes += 1
                        if(RedConsecutiveSixes >= 3):
                            set RedPlayerTurn = false
                            set BluePlayerTurn = true
                            set RedConsecutiveSixes = 0
                        # else keep turn
                    else:
                        set RedConsecutiveSixes = 0
                        set RedPlayerTurn = false
                        set BluePlayerTurn = true
                    set RedDiceRollValue = 0
            else:
                Print("Not enough remaining path for the dice roll. Move is invalid.")

        
        set WhichColorElim = 0
        if (RedZeroHighlight.HIghlightIntensity = 20.0):
            set RedPawnIndex = CurrentIndex
            set WhichPawn = 0
            spawn{PossibleElimChecker(RedPawnIndex, WhichPawn, WhichColorElim, Agent)}
