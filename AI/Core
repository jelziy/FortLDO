    PlayerJoined(Agent : agent):void=(
        if(Red.Player = false and GameStarted = false):
            set Red.Player = option{Agent}
            Red.Device.Camera.Enable()
            Red.Device.Camera.AddTo(Agent)
            Red.Device.Chair.Seat(Agent)
            Red.Device.Chair.DisableExit()
            if:
                FcIcon := Agent.GetFortCharacter[].GetEntity[].GetComponent[icon_component].Icon
                Player := player[Agent]
            then:
                set RedPlayerIcon.TexParam = FcIcon
                Red.Device.AvatarProp.SetMaterial(RedPlayerIcon)
            
            if(GameStarted = false):
                set AllPlayersPawns = array{Red.Pns.Pawn, Red.Pns.PawnOne, Red.Pns.PawnTwo, Red.Pns.PawnThree, Blue.Pns.Pawn, Blue.Pns.PawnOne,
                                    Blue.Pns.PawnTwo, Blue.Pns.PawnThree, Green.Pns.Pawn, Green.Pns.PawnOne, Green.Pns.PawnTwo, Green.Pns.PawnThree, Yellow.Pns.Pawn, 
