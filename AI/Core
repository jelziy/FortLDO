    PlayerExiting(Agent:agent):void=(
         if(RedPlayer = option{Agent} and GameStarted = true): #in this case gamestarted will always be true, because the if the agent has joined the game has started as it only requires one player.
            set RedPlayer = false
            spawn{LeaveWidget(Agent)}           
            PlayerCamera.RemoveFrom(Agent)
            PlayerCamera.Disable()
            PlayerChair.EnableExit()
            if(RedPawn.TeleportTo[RedPawnInitialTransform]):
            if(RedPawnOne.TeleportTo[RedPawnOneInitialTransform]): 
            if(RedPawnTwo.TeleportTo[RedPawnTwoInitialTransform]): 
            if(RedPawnThree.TeleportTo[RedPawnThreeInitialTransform]):
            set AllRedPawn = array{RedPawn, RedPawnOne, RedPawnTwo, RedPawnThree}
            for(Pawns : AllRedPawn):
                Pawns.Hide()
            RedIndexInitialSetter()
            if(not FinishedOrder.Find[0]):
                set ActivePlayerCount -= 1

            set RedPlayerIcon.TexParam = NormAv
            RedPlayerAvProp.SetMaterial(RedPlayerIcon)

            PlayerTp.Teleport(Agent)
            
            spawn. GameOverReset(1)

            PlayerCamera.RemoveFrom(Agent) #temporary solution
    )
        

