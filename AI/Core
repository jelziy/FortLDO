    PlayerJoined(Agent : agent):void=(
        if(RedPlayer = false and GameStarted = false):
            set RedPlayer = option{Agent}
            Red.Device.Camera.Enable()
            Red.Device.Camera.AddTo(Agent)
            Red.Device.Chair.Seat(Agent)
            Red.Device.Chair.DisableExit()
            if:
                FcIcon := Agent.GetFortCharacter[].GetEntity[].GetComponent[icon_component].Icon
                Player := player[Agent]
            then:
                set RedPlayerIcon.TexParam = FcIcon
                Red.Device.AvatarProp.SetMaterial(RedPlayerIcon)
            
            if(GameStarted = false):
                set AllPlayersPawns = array{Red.Pns.Pawn, Red.Pns.PawnOne, Red.Pns.PawnTwo, Red.Pns.PawnThree, Blue.Pns.Pawn, Blue.Pns.PawnOne,
                                    Blue.Pns.PawnTwo, Blue.Pns.PawnThree, Green.Pns.Pawn, Green.Pns.PawnOne, Green.Pns.PawnTwo, Green.Pns.PawnThree, Yellow.Pns.Pawn, 
                                    Yellow.Pns.PawnOne, Yellow.Pns.PawnTwo, Yellow.Pns.PawnThree}
                for(Pawns : AllPlayersPawns):
                    Pawns.Show()
                    spawn. GameStartInitiator()
            else:
                Print("Game Started")
    )

    SelectPressed(Agent:agent):void=(
        var Attempts:int = 0
        
        if(RedPlayer = option{Agent} and Red.IsTurn = true  and ConfirmFlag = false):
            loop:
                if(Attempts >= 4):
                    break
                if (RollerForPlayer = 0 and Red.PawnFinished = false):
                    ResetAllHighlights()
                    set RedZeroHighlight.HIghlightIntensity = 20.0
                    Red.Pns.Pawn.SetMaterial(RedZeroHighlight)
                    set RollerForPlayer += 1
                    APHighlight.Play(Agent)
                    Print("Higlidhting Red Pawn 0")
                    break
                else if (RollerForPlayer = 1 and Red.PawnOneFinished = false):
                    ResetAllHighlights()
                    set RedOneHighlight.HIghlightIntensity = 20.0
                    Red.Pns.PawnOne.SetMaterial(RedOneHighlight)
                    set RollerForPlayer += 1
                    APHighlight.Play(Agent)
                    break
                else if (RollerForPlayer = 2 and Red.PawnTwoFinished = false):
                    ResetAllHighlights()
                    set RedTwoHighlight.HIghlightIntensity = 20.0
                    Red.Pns.PawnTwo.SetMaterial(RedTwoHighlight)
                    set RollerForPlayer += 1
                    APHighlight.Play(Agent)
                    break
                else if ( RollerForPlayer = 3 and Red.PawnThreeFinished = false):
                    ResetAllHighlights()
                    set RedThreeHighlight.HIghlightIntensity = 20.0
                    Red.Pns.PawnThree.SetMaterial(RedThreeHighlight)
                    set RollerForPlayer = 0
                    APHighlight.Play(Agent)
                    break
                else:
                    if(RollerForPlayer = 0 and Red.PawnFinished = true):
                        set RollerForPlayer = 1
                    else if(RollerForPlayer = 1 and Red.PawnOneFinished = true):
                        set RollerForPlayer = 2
                    else if(RollerForPlayer = 2 and Red.PawnTwoFinished = true):
                        set RollerForPlayer = 3
                    else if(RollerForPlayer = 3 and Red.PawnThreeFinished = true):
                        set RollerForPlayer = 0
                    set Attempts += 1     
    )

