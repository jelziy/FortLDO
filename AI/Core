    ResetPlayerDrainerProfile():void=(
        if(RedPropProfile := RedDiceProp[1]): #the blinking ones
            RedPropProfile.Hide()
        if(BluePropProfile := BlueDiceProp[1]):
            BluePropProfile.Hide()
        if(GreenPropProfile := GreenDiceProp[1]):
            GreenPropProfile.Hide()
        if(YellowPropProfile := YellowDiceProp[1]):
            YellowPropProfile.Hide()
    )

    HelperPlayerProfileTurn()<suspends>:void=
        if(RedPlayerTurn = true):
            if(RedPropProfile := RedDiceProp[1]):
                ResetPlayerDrainerProfile()
                Sleep(1.0)
                RedPropProfile.Show()
            Print("Red Player's Turn")
            spawn{CheckTimerForRed()}
        else if(BluePlayerTurn = true):
            if(BluePropProfile := BlueDiceProp[1]):
                ResetPlayerDrainerProfile()
                Sleep(1.0)
                BluePropProfile.Show()
            Print("Blue Player's Turn")
            spawn{CheckTimerForBlue()}
        else if(GreenPlayerTurn = true):
            if(GreenPropProfile := GreenDiceProp[1]):
                ResetPlayerDrainerProfile()
                Sleep(1.0)
                GreenPropProfile.Show()
            Print("Green Player's Turn")
            spawn{CheckTimerForGreen()}
        else if(YellowPlayerTurn = true):
            if(YellowPropProfile := YellowDiceProp[1]):
                ResetPlayerDrainerProfile()
                Sleep(1.0)
                YellowPropProfile.Show()
            Print("Yellow Player's Turn")
            spawn{CheckTimerForYellow()}

    CheckTimerForRed()<suspends>:void=
