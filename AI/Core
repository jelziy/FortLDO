    # Runs when the device is started in a running game
    OnBegin<override>()<suspends>:void=
        InitialInitiator()     
        set AllPlayersPawns = array{RedPawn, RedPawnOne, RedPawnTwo, RedPawnThree, BluePawn, BluePawnOne,
                                    BluePawnTwo, BluePawnThree, GreenPawn, GreenPawnOne, GreenPawnTwo, GreenPawnThree, YellowPawn, 
                                    YellowPawnOne, YellowPawnTwo, YellowPawnThree}
        for(PlayerPawn : AllPlayersPawns):
            PlayerPawn.Hide()

        JoinButton.InteractedWithEvent.Subscribe(PlayerJoined)
        Select.PressedEvent.Subscribe(SelectPressed)
        ConfirmInput.PressedEvent.Subscribe(ConfirmPressed)
        Leave.PressedEvent.Subscribe(PlayerExiting)
        DiceRoll.PressedEvent.Subscribe(DiceRollPressed)
        GetPlayspace().PlayerRemovedEvent().Subscribe(PlayerExiting)

    InitialInitiator():void=
        set RedPawnInitialTransform = RedPawn.GetTransform()
        set RedPawnOneInitialTransform = RedPawnOne.GetTransform()
        set RedPawnTwoInitialTransform = RedPawnTwo.GetTransform()
        set RedPawnThreeInitialTransform = RedPawnThree.GetTransform()
        set BluePawnInitialTransform = BluePawn.GetTransform()
        set BluePawnOneInitialTransform = BluePawnOne.GetTransform()
        set BluePawnTwoInitialTransform = BluePawnTwo.GetTransform()
        set BluePawnThreeInitialTransform = BluePawnThree.GetTransform()
        set YellowPawnInitialTransform = YellowPawn.GetTransform()
        set YellowPawnOneInitialTransform = YellowPawnOne.GetTransform()
        set YellowPawnTwoInitialTransform = YellowPawnTwo.GetTransform()
        set YellowPawnThreeInitialTransform = YellowPawnThree.GetTransform()
        set GreenPawnInitialTransform = GreenPawn.GetTransform()
        set GreenPawnOneInitialTransform = GreenPawnOne.GetTransform()
        set GreenPawnTwoInitialTransform = GreenPawnTwo.GetTransform()
        set GreenPawnThreeInitialTransform = GreenPawnThree.GetTransform()
        ResetPlayerDrainerProfile()
    
    GameStartInitiator()<suspends>:void=
        set GameStarted = true
        set RedPlayerTurn = true
        spawn{HelperPlayerProfileTurn()}
        
    PlayerJoined(Agent : agent):void=
        if(LdoPlayer = false and GameStarted = false):
            set LdoPlayer = option{Agent}
            PlayerCamera.AddTo(Agent)
            PlayerChair.Seat(Agent)
            PlayerChair.DisableExit()
            if:
                FcIcon := Agent.GetFortCharacter[].GetEntity[].GetComponent[icon_component].Icon
                Player := player[Agent]
            then:
                set PlayerIcon.TexParam = FcIcon
                PlayerAvProp.SetMaterial(PlayerIcon)
            
            if(GameStarted = false):
                set AllPlayersPawns = array{RedPawn, RedPawnOne, RedPawnTwo, RedPawnThree, BluePawn, BluePawnOne,
                                    BluePawnTwo, BluePawnThree, GreenPawn, GreenPawnOne, GreenPawnTwo, GreenPawnThree, YellowPawn, 
                                    YellowPawnOne, YellowPawnTwo, YellowPawnThree}
                for(Pawns : AllPlayersPawns):
                    Pawns.Show()
                    spawn. GameStartInitiator()
            else:
                Print("Game Started")

