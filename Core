    RedOneJoined(Agent : agent) : void = (

        if(Red.Player = false and GameStarted = false):
            if:
                option{Agent} <> Blue.Player
                option{Agent} <> Yellow.Player
                option{Agent} <> Green.Player
            then:
                #spawn{LoadWidget(Agent)}
                #RedCamera.AddTo(Agent)   #just to check hash
                set Red.Player = option{Agent}
                Red.Device.Chair.DisableExit()
                Red.Device.LobbyPlayerRef.Register(Agent)
                if:
                    FcIcon := Agent.GetFortCharacter[].GetEntity[].GetComponent[icon_component].Icon
                    Player := player[Agent]
                then:
                    set RedPlayerIcon.TexParam = FcIcon
                    Red.Device.AvatarProp.SetMaterial(RedPlayerIcon)
                
                if(GameStarted = false):
                    AllRedPawn : []creative_prop = Red.GetPawn()
                    for(RedPawnForRedJoined : AllRedPawn):
                        RedPawnForRedJoined.Show()
                        spawn{GameStartInitiator()}
                else if(GameStarted = true):
                    Print("Game has already started. You cannot join now.")
    )

