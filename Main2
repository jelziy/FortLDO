                            set BluePlayerTurn = true
                            set RedConsecutiveSixes = 0
                        else:
                            # Keep turn
                            set RedPlayerTurn = true
                    else:
                        set RedPlayerTurn = false
                        set BluePlayerTurn = true

                    set CurrentIndex = 0
                    set RedDiceRollValue = 0


        else if(CurrentIndex >= 0):
            Print("Stepwise movement, starting at index {CurrentIndex}")
