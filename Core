    GameStartInitiator()<suspends>:void=(
        var PlayerCount : int = 0
        if(RedPlayer?):
            set PlayerCount += 1
        if(BluePlayer?):
            set PlayerCount += 1
        if(YellowPlayer?):
            set PlayerCount += 1
        if(GreenPlayer?):
            set PlayerCount += 1
        
        Sleep(2.0) # Small delay to ensure all players are registered before starting the game
        if(OnePlayerSwitch.GetCurrentState[]):
            if(PlayerCount = 1):
                set GameStarted = true
                RedTurnSetter()
                set ActivePlayerCount = PlayerCount
                spawn{HelperPlayerProfileTurn()}
                
        if(TwoPlayerSwitch.GetCurrentState[] and GameStarted = false):
            if(PlayerCount = 2):
                CamChairGranter()
                set GameStarted = true
                RedTurnSetter()
                set ActivePlayerCount = PlayerCount
                set GameFormat = 2
                spawn{HelperPlayerProfileTurn()}
                GameCostDeductor()

        else if(ThreePlayerSwitch.GetCurrentState[] and GameStarted = false):
            if(PlayerCount = 3):
                CamChairGranter()
                set GameStarted = true
                RedTurnSetter()
                set ActivePlayerCount = PlayerCount
                set GameFormat = 3
                spawn{HelperPlayerProfileTurn()}
                GameCostDeductor()

        else if(FourPlayerSwitch.GetCurrentState[] and GameStarted = false):
            if(PlayerCount = 4):
                CamChairGranter()
                set GameStarted = true
                RedTurnSetter()
                set ActivePlayerCount = PlayerCount
                set GameFormat = 4
                spawn{HelperPlayerProfileTurn()}
                GameCostDeductor()

        if(GameStarted = true):
            for(Music : APEnvOg):
                Music.Stop()
            APInGame.Play()  
    )
    
    RedTurnSetter():void=(
        if(RedPlayer?):
            set RedPlayerTurn = true
        else if(BluePlayer?):
            set BluePlayerTurn = true
        else if(YellowPlayer?):
            set YellowPlayerTurn = true
        else if(GreenPlayer?):
