            set AllBluePawn = array{BluePawn, BluePawnOne, BluePawnTwo, BluePawnThree}
            for(Pawns : AllBluePawn):
                Pawns.Hide()
            BlueIndexInitialSetter()
            if(not FinishedOrder.Find[1]):
                set ActivePlayerCount -= 1

        else if(YellowPlayer = option{Agent}):
            #set YellowPlayer = false
            YellowCamera.RemoveFrom(Agent)
            YellowChair.EnableExit()
            if(YellowPawn.TeleportTo[YellowPawnInitialTransform]): 
