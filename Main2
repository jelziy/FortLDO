    MovePawnGreen(Pawn:creative_prop, Index:int, Agent:agent)<suspends>:void=(
        var CurrentIndex : int = Index
        PawnTransform := Pawn.GetTransform()
        PawnZ := PawnTransform.Translation.Z
        var WhichPawn :int = -1

        if(CurrentIndex = -1 and GreenDiceRollValue = 6):
            if(Path := GreenPaths[0]):
                PathTransform := Path.GetTransform()
                PathTranslation := PathTransform.Translation
                NewPos := vector3{X := PathTranslation.X, Y := PathTranslation.Y, Z := PawnZ}
                if(Pawn.TeleportTo[NewPos, PawnTransform.Rotation]):
                    APMove.Play()
                    set CurrentIndex = 0
                    set GreenConsecutiveSixes += 1
                    if(GreenConsecutiveSixes >= 3):
                        set GreenPlayerTurn = false
                        set RedPlayerTurn = true
                        set GreenConsecutiveSixes = 0

                    set GreenDiceRollValue = 0


        else if(CurrentIndex >= 0):
            Print("Stepwise movement, starting at index {CurrentIndex}")
            TargetIndex := CurrentIndex + GreenDiceRollValue
            RemainingPaths := GreenPaths.Length - CurrentIndex - 1
            if(GreenDiceRollValue <= RemainingPaths):
                if(TargetIndex < GreenPaths.Length):
                    for (Step := 1..GreenDiceRollValue):
                        NextIndex := CurrentIndex + Step
                        Print("Step {Step}: NextIndex = {NextIndex}")
                        if(Path := GreenPaths[NextIndex]):
                            PathTransform := Path.GetTransform()
                            PathTranslation := PathTransform.Translation
                            NewPos := vector3{X := PathTranslation.X, Y := PathTranslation.Y, Z := PawnZ}
                            if(Pawn.TeleportTo[NewPos, PawnTransform.Rotation]):
                                APMove.Play()
                                Sleep(0.4)
                    set CurrentIndex = TargetIndex
                    if(GreenDiceRollValue = 6):
                        set GreenConsecutiveSixes += 1
                        if(GreenConsecutiveSixes >= 3):
                            # Switch to Yellow turn, reset counter
                            set GreenPlayerTurn = false
                            set RedPlayerTurn = true
                            set GreenConsecutiveSixes = 0
                        else:
                            # Keep turn
                            set GreenPlayerTurn = true
                    else:
                        set GreenPlayerTurn = false
                        set RedPlayerTurn = true

                    set GreenDiceRollValue = 0
                                
            else:
                Print("Not enough remaining path for the dice roll. Move is invalid.")
        
        set WhichColorElim = 3
        if (GreenZeroHighlight.HIghlightIntensity = 20.0):
            set GreenPawnIndex = CurrentIndex
            set WhichPawn = 0
            spawn{PossibleElimChecker(GreenPawnIndex, WhichPawn, WhichColorElim, Agent)}
        else if (GreenOneHighlight.HIghlightIntensity = 20.0):
            set GreenPawnOneIndex = CurrentIndex
            set WhichPawn = 1
            spawn{PossibleElimChecker(GreenPawnOneIndex, WhichPawn, WhichColorElim, Agent)}
        else if (GreenTwoHighlight.HIghlightIntensity = 20.0):
            set GreenPawnTwoIndex = CurrentIndex
            set WhichPawn = 2
            spawn{PossibleElimChecker(GreenPawnTwoIndex, WhichPawn, WhichColorElim, Agent)}
        else if (GreenThreeHighlight.HIghlightIntensity = 20.0):
            set GreenPawnThreeIndex = CurrentIndex
            set WhichPawn = 3
            spawn{PossibleElimChecker(GreenPawnThreeIndex, WhichPawn, WhichColorElim, Agent)}

        spawn{HelperPlayerProfileTurn()}
        ResetAllHighlights(Agent)
        spawn{CheckTimerForRed()}    
    )

