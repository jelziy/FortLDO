    PlayerExiting(Agent:agent):void=(
         if(RedPlayer = option{Agent} and GameStarted = true): #in this case gamestarted will always be true, because the if the agent has joined the game has started as it only requires one player.
            set RedPlayer = false
            spawn{LeaveWidget(Agent)}           
            Red.Device.Camera.RemoveFrom(Agent)
            Red.Device.Camera.Disable()
            Red.Device.Chair.EnableExit()
            if(Red.Pns.Pawn.TeleportTo[Red.PawnInitialTransform]):
            if(Red.Pns.PawnOne.TeleportTo[Red.PawnOneInitialTransform]): 
            if(Red.Pns.PawnTwo.TeleportTo[Red.PawnTwoInitialTransform]): 
            if(Red.Pns.PawnThree.TeleportTo[Red.PawnThreeInitialTransform]):
            set AllRedPawn = array{Red.Pns.Pawn, Red.Pns.PawnOne, Red.Pns.PawnTwo, Red.Pns.PawnThree}
            for(Pawns : AllRedPawn):
                Pawns.Hide()
            Red.ResetPawnState()
            if(not FinishedOrder.Find[0]):
                set ActivePlayerCount -= 1

            set RedPlayerIcon.TexParam = NormAv
            Red.Device.AvatarProp.SetMaterial(RedPlayerIcon)

            Red.Device.ExitTp.Teleport(Agent)
            
            spawn. GameOverReset(1)

            Red.Device.Camera.RemoveFrom(Agent) #temporary solution
    )
        

