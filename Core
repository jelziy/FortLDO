    LoadWidget(Agent:agent)<suspends>:void=(
        if(Player := player[Agent]):
            if(PlayerUI := GetPlayerUI[Player]):
                PlayerUI.AddWidget(WidgetLoading, player_ui_slot{InputMode := ui_input_mode.All})
                PlayerUI.SetFocus(WidgetLoading)
                Sleep(6.0)
                PlayerUI.RemoveWidget(WidgetLoading)
            
    )

    LeaveWidget(Agent:agent)<suspends>:void=(
        if(Player := player[Agent]):
            if(PlayerUI := GetPlayerUI[Player]):
                PlayerUI.AddWidget(WidgetLeaving, player_ui_slot{InputMode := ui_input_mode.All})
                PlayerUI.SetFocus(WidgetLoading)
                Sleep(6.0)
                PlayerUI.RemoveWidget(WidgetLeaving)
    )

    ExitingTheArena(Agent:agent):void=(

        if(Red.Player = option{Agent}):
            set Red.Player = false
            spawn{LeaveWidget(Agent)}           
            Red.Device.Camera.RemoveFrom(Agent)
            Red.Device.Camera.Disable()
            Red.Device.Chair.EnableExit()
            #-----------------------------
            Red.HidePawns()
            Red.ResetPawnState()
            if(not FinishedOrder.Find[0]):
                set ActivePlayerCount -= 1

            set RedPlayerIcon.TexParam = General.DefaultAv
            Red.Device.AvatarProp.SetMaterial(RedPlayerIcon)

            Red.Device.ExitTp.Teleport(Agent)
            Red.Device.LobbyPlayerRef.Clear()
            
            

        else if(Blue.Player = option{Agent}):
            set Blue.Player = false # for PlayTesting.... was "#"# there not now
            spawn{LeaveWidget(Agent)}
            Blue.Device.Camera.RemoveFrom(Agent)
            Blue.Device.Camera.Disable()
            Blue.Device.Chair.EnableExit()
            #--------------
            Blue.ResetPawnState()
            if(not FinishedOrder.Find[1]):
                set ActivePlayerCount -= 1
            
            set BluePlayerIcon.TexParam = General.DefaultAv
            Blue.Device.AvatarProp.SetMaterial(BluePlayerIcon)

            Blue.Device.ExitTp.Teleport(Agent)
            Blue.Device.LobbyPlayerRef.Clear()

        else if(Yellow.Player = option{Agent}):
            set Yellow.Player = false
            spawn{LeaveWidget(Agent)}
            Yellow.Device.Camera.RemoveFrom(Agent)
            Yellow.Device.Camera.Disable()
            Yellow.Device.Chair.EnableExit()
            #---------------
            Yellow.ResetPawnState()
            if(not FinishedOrder.Find[2]):
                set ActivePlayerCount -= 1
            
            set YellowPlayerIcon.TexParam = General.DefaultAv
            Yellow.Device.AvatarProp.SetMaterial(YellowPlayerIcon)

            Yellow.Device.ExitTp.Teleport(Agent)
            Yellow.Device.LobbyPlayerRef.Clear()

        else if(Green.Player = option{Agent}):
            set Green.Player = false
            spawn{LeaveWidget(Agent)}
            Green.Device.Camera.RemoveFrom(Agent)
            Green.Device.Camera.Disable()
            Green.Device.Chair.EnableExit()
            #---------------
            Green.ResetPawnState()
            if(not FinishedOrder.Find[3]):
                set ActivePlayerCount -= 1

            
            set GreenPlayerIcon.TexParam = General.DefaultAv
            Green.Device.AvatarProp.SetMaterial(GreenPlayerIcon)

            Green.Device.ExitTp.Teleport(Agent)
            Green.Device.LobbyPlayerRef.Clear()

        if(ActivePlayerCount <= 1 and GameStarted = true):
            spawn. GameOverReset(1)

        Red.Device.Camera.RemoveFrom(Agent) #temporary solution
        Blue.Device.Camera.RemoveFrom(Agent)
        Yellow.Device.Camera.RemoveFrom(Agent)
        Green.Device.Camera.RemoveFrom(Agent)
    )

