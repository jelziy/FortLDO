    # Runs when the device is started in a running game
    OnBegin<override>()<suspends>:void=(
        
        InitialInitiator()     
        set AllPlayersPawns = array{Red.Pns.Pawn, Red.Pns.PawnOne, Red.Pns.PawnTwo, Red.Pns.PawnThree, Blue.Pns.Pawn, Blue.Pns.PawnOne,
                                    Blue.Pns.PawnTwo, Blue.Pns.PawnThree, Green.Pns.Pawn, Green.Pns.PawnOne, Green.Pns.PawnTwo, Green.Pns.PawnThree, Yellow.Pns.Pawn, 
                                    Yellow.Pns.PawnOne, Yellow.Pns.PawnTwo, Yellow.Pns.PawnThree}
        for(PlayerPawn : AllPlayersPawns):
            PlayerPawn.Hide()
        Red.Device.JoinButton.InteractedWithEvent.Subscribe(RedOneJoined)
        Blue.Device.JoinButton.InteractedWithEvent.Subscribe(BlueOneJoined)
        Green.Device.JoinButton.InteractedWithEvent.Subscribe(GreenOneJoined)
        Yellow.Device.JoinButton.InteractedWithEvent.Subscribe(YellowOneJoined)

        SelectZero.PressedEvent.Subscribe(SelectZeroPressed)
        ConfirmInput.PressedEvent.Subscribe(ConfirmInputPressed)
        DiceRoll.PressedEvent.Subscribe(DiceRollPressed)
        SelectOne.PressedEvent.Subscribe(ExitingTheArena)
        GetPlayspace().PlayerRemovedEvent().Subscribe(ExitingTheArena)
        
    
        Sleep(7.0)
        General.Audio.Ambiant.Play()
    )

    InitialInitiator():void=(
        Red.CaptureInitialTransforms()
        Blue.CaptureInitialTransforms()
        Yellow.CaptureInitialTransforms()
