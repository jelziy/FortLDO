    CheckTimerForRed()<suspends>:void=(
        var StartTime: float = GetSimulationElapsedTime()
        loop:
            Sleep(0.2)
            if(RedPlayerTurn = false):
                return
            var Elapsed : float = GetSimulationElapsedTime() - StartTime
            #Print("Timer {Elapsed}")
            if(Elapsed >= CoolDownTime):
                Print("Time Out! Moving to next player.")
                set RedPlayerTurn = false
                if(BluePlayer?):
                    set BluePlayerTurn = true
                else if(YellowPlayer?):
                    set YellowPlayerTurn = true
                else if(GreenPlayer?):
                    set GreenPlayerTurn = true
                set DoubleRollFlagPlayer = false
                set RedConsecutiveSixes = 0
                spawn{HelperPlayerProfileTurn()}
                TimerCheckerHelper()
                return

            else if(RedPlayer = false):
                set RedPlayerTurn = false
                if(BluePlayer?):
                    set BluePlayerTurn = true
                else if(YellowPlayer?):
                    set YellowPlayerTurn = true
                else if(GreenPlayer?):
                    set GreenPlayerTurn = true
                set DoubleRollFlagPlayer = false
                set RedConsecutiveSixes = 0
                spawn{HelperPlayerProfileTurn()}
                TimerCheckerHelper()

                return
    )
    
