                    Pawns.Show()
                    spawn. GameStartInitiator()
            else:
                Print("Game Started")
    )

    SelectPressed(Agent:agent):void=(
        var Attempts:int = 0
        
        if(Red.Player = option{Agent} and Red.IsTurn = true  and ConfirmFlag = false):
            loop:
                if(Attempts >= 4):
                    break
                if (Red.Roller = 0 and Red.PawnFinished = false):
                    ResetAllHighlights()
                    set RedZeroHighlight.HIghlightIntensity = 20.0
                    Red.Pns.Pawn.SetMaterial(RedZeroHighlight)
                    set Red.Roller += 1
                    General.Audio.Highlight.Play(Agent)
                    Print("Higlidhting Red Pawn 0")
                    break
                else if (Red.Roller = 1 and Red.PawnOneFinished = false):
                    ResetAllHighlights()
                    set RedOneHighlight.HIghlightIntensity = 20.0
                    Red.Pns.PawnOne.SetMaterial(RedOneHighlight)
                    set Red.Roller += 1
                    General.Audio.Highlight.Play(Agent)
                    break
                else if (Red.Roller = 2 and Red.PawnTwoFinished = false):
                    ResetAllHighlights()
                    set RedTwoHighlight.HIghlightIntensity = 20.0
                    Red.Pns.PawnTwo.SetMaterial(RedTwoHighlight)
                    set Red.Roller += 1
                    General.Audio.Highlight.Play(Agent)
                    break
                else if ( Red.Roller = 3 and Red.PawnThreeFinished = false):
                    ResetAllHighlights()
                    set RedThreeHighlight.HIghlightIntensity = 20.0
                    Red.Pns.PawnThree.SetMaterial(RedThreeHighlight)
                    set Red.Roller = 0
                    General.Audio.Highlight.Play(Agent)
                    break
                else:
                    if(Red.Roller = 0 and Red.PawnFinished = true):
                        set Red.Roller = 1
                    else if(Red.Roller = 1 and Red.PawnOneFinished = true):
                        set Red.Roller  = 2
                    else if(Red.Roller  = 2 and Red.PawnTwoFinished = true):
                        set Red.Roller = 3
                    else if(Red.Roller = 3 and Red.PawnThreeFinished = true):
                        set Red.Roller = 0
                    set Attempts += 1     
    )

