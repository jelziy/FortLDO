    PossibleMoveChecker()<suspends>:void=(
        ###after a dice roll, for perticular player check if the player can make a move with any of its pawn, 
        ##if not then switch the turm to the next player###
        var RedPawnIndices : []int = array{Red.PawnIndex, Red.PawnOneIndex, Red.PawnTwoIndex, Red.PawnThreeIndex}
        var CanMove : logic = false
        PathLenght := Red.Pns.Paths.Length #same number for each
        var PawnIndices : []int = array{}
        var TurnNumber : int = 0
        var DiceValue : int = 0
        
        if(Red.Player? and Red.IsTurn = true):
            for(PawnIdx : RedPawnIndices):
                if(PawnIdx = -1 and Red.DiceRollValue = 6):
                    set CanMove = true
                else if(PawnIdx >= 0 and PawnIdx + Red.DiceRollValue < PathLenght):
                    set CanMove = true
                
            if(CanMove = true):
                Print("nothing to do stay as it is")
                if(Red.IsTurn = true):
                    spawn{CheckTimerForRed()}

                return
            else:
                Sleep(1.0)
                TurnChanger(1, false)
                set Red.DoubleRollFlag = false
                set ConfirmFlag = false
                TimerCheckerHelper()
                Print("False cant move")

                return

        else if( BluePlayer = true and Blue.IsTurn = true): #check timer perticular color is being removed, just keep in mind if any bugs happen this can be the cause
            set PawnIndices = array{Blue.PawnIndex, Blue.PawnOneIndex, Blue.PawnTwoIndex, Blue.PawnThreeIndex}
            set DiceValue = Blue.DiceRollValue
            set TurnNumber = 2

        else if(YellowPlayer = true and Yellow.IsTurn = true):
            set PawnIndices = array{Yellow.PawnIndex, Yellow.PawnOneIndex, Yellow.PawnTwoIndex, Yellow.PawnThreeIndex}
            set DiceValue = Yellow.DiceRollValue
            set TurnNumber = 3

        else if(GreenPlayer = true and Green.IsTurn = true):
            set PawnIndices = array{Green.PawnIndex, Green.PawnOneIndex, Green.PawnTwoIndex, Green.PawnThreeIndex}
            set DiceValue = Green.DiceRollValue
            set TurnNumber = 4
        
        PossiblePawns := GetPossiblePawns(PawnIndices, DiceValue, Red.Pns.Paths.Length) #pathlength giving unknown identifier

        if(PossiblePawns.Length > 0):
            RandomIndex := GetRandomInt(0, PossiblePawns.Length - 1)
            if(ChoosenPawn := PossiblePawns[RandomIndex]):
                Print("Bot selected pawn : {ChoosenPawn}")

                Sleep(2.0)
                if(TurnNumber = 1):
                    #dont need it
                else if(TurnNumber = 2):
                    if(ChoosenPawn = 0):
                        spawn. BotMovePawnBlue(Blue.Pns.Pawn, Blue.PawnIndex, 0)
                    else if(ChoosenPawn = 1):
