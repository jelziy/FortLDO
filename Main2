        set YellowPawnOneInitialTransform = YellowPawnOne.GetTransform()
        set YellowPawnTwoInitialTransform = YellowPawnTwo.GetTransform()
        set YellowPawnThreeInitialTransform = YellowPawnThree.GetTransform()
        set GreenPawnInitialTransform = GreenPawn.GetTransform()
        set GreenPawnOneInitialTransform = GreenPawnOne.GetTransform()
        set GreenPawnTwoInitialTransform = GreenPawnTwo.GetTransform()
        set GreenPawnThreeInitialTransform = GreenPawnThree.GetTransform()

        set AllPlayersPawns = array{RedPawn, RedPawnOne, RedPawnTwo, RedPawnThree, BluePawn, BluePawnOne,
                                    BluePawnTwo, BluePawnThree, GreenPawn, GreenPawnOne, GreenPawnTwo, GreenPawnThree, YellowPawn, 
                                    YellowPawnOne, YellowPawnTwo, YellowPawnThree}
        for(PlayerPawn : AllPlayersPawns):
            PlayerPawn.Hide()
        RedButton.InteractedWithEvent.Subscribe(RedOneJoined)
        BlueButton.InteractedWithEvent.Subscribe(BlueOneJoined)
        GreenButton.InteractedWithEvent.Subscribe(GreenOneJoined)
        YellowButton.InteractedWithEvent.Subscribe(YellowOneJoined)

        SelectZero.PressedEvent.Subscribe(SelectZeroPressed)
        ConfirmInput.PressedEvent.Subscribe(ConfirmInputPressed)
        DiceRoll.PressedEvent.Subscribe(DiceRollPressed)
    )

    GameStartInitiator():void=(
        var PlayerCount : int = 0
        if(RedPlayer?):
            set PlayerCount += 1
        if(BluePlayer?):
            set PlayerCount += 1
        if(YellowPlayer?):
            set PlayerCount += 1
        if(GreenPlayer?):
            set PlayerCount += 1
        
        if(OnePlayerSwitch.GetCurrentState[]):
            if(PlayerCount = 1):
                set GameStarted = true
                set RedPlayerTurn = true
        if(TwoPlayerSwitch.GetCurrentState[]):
            if(PlayerCount = 2):
                set GameStarted = true
                set RedPlayerTurn = true

        else if(ThreePlayerSwitch.GetCurrentState[]):
            if(PlayerCount = 3):
                set GameStarted = true
                set RedPlayerTurn = true

        else if(FourPlayerSwitch.GetCurrentState[]):
            if(PlayerCount = 4):
                set GameStarted = true
                set RedPlayerTurn = true
    )       

    DiceRollPressed(Agent:agent):void=(
        if(RedPlayer = option{Agent}):
            if(RedPlayerTurn = true):
                RollValue := GetRandomInt(1,6)
                set RedDiceRollValue = RollValue
                if(DiceProp := RedDiceProp[0]):
                    DiceProp.SetMaterial(RollingDice)
                    spawn{HelperDiceRoll(Agent)}
                    spawn{PossibleMoveChecker(Agent)}
                Print("Dice Rolled: {RollValue} ")
        else if(BluePlayer = option{Agent}):
            if(BluePlayerTurn = true):
                RollValue := GetRandomInt(1,6)
                set BlueDiceRollValue = RollValue
                if(DiceProp := BlueDiceProp[0]):
