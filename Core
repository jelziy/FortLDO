    GameStartInitiator()<suspends>:void=(
        var PlayerCount : int = 0
        if(Red.Player?):
            set PlayerCount += 1
        if(Blue.Player?):
            set PlayerCount += 1
        if(Yellow.Player?):
            set PlayerCount += 1
        if(Green.Player?):
            set PlayerCount += 1
        
        Sleep(2.0) # Small delay to ensure all players are registered before starting the game
        if(OnePlayerSwitch.GetCurrentState[]):
            if(PlayerCount = 1):
                set GameStarted = true
                RedTurnSetter()
                set ActivePlayerCount = PlayerCount
                spawn{HelperPlayerProfileTurn()}
                
        if(TwoPlayerSwitch.GetCurrentState[] and GameStarted = false):
            if(PlayerCount = 2):
                CamChairGranter()
                set GameStarted = true
                RedTurnSetter()
                set ActivePlayerCount = PlayerCount
                set GameFormat = 2
                spawn{HelperPlayerProfileTurn()}
                GameCostDeductor()

        else if(ThreePlayerSwitch.GetCurrentState[] and GameStarted = false):
            if(PlayerCount = 3):
                CamChairGranter()
                set GameStarted = true
                RedTurnSetter()
                set ActivePlayerCount = PlayerCount
                set GameFormat = 3
                spawn{HelperPlayerProfileTurn()}
                GameCostDeductor()

        else if(FourPlayerSwitch.GetCurrentState[] and GameStarted = false):
            if(PlayerCount = 4):
                CamChairGranter()
                set GameStarted = true
                RedTurnSetter()
                set ActivePlayerCount = PlayerCount
                set GameFormat = 4
                spawn{HelperPlayerProfileTurn()}
                GameCostDeductor()

        if(GameStarted = true):
            General.Audio.Ambiant.Stop()
            AudioPlayerMain(General.Audio.InGame)
    )
    
