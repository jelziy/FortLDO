    PlayerJoined(Agent : agent):void=(
        if(RedPlayer = false and GameStarted = false):
            set RedPlayer = option{Agent}
            PlayerCamera.Enable()
            PlayerCamera.AddTo(Agent)
            PlayerChair.Seat(Agent)
            PlayerChair.DisableExit()
            if:
                FcIcon := Agent.GetFortCharacter[].GetEntity[].GetComponent[icon_component].Icon
                Player := player[Agent]
            then:
                set RedPlayerIcon.TexParam = FcIcon
                RedPlayerAvProp.SetMaterial(RedPlayerIcon)
            
            if(GameStarted = false):
                set AllPlayersPawns = array{RedPawn, RedPawnOne, RedPawnTwo, RedPawnThree, BluePawn, BluePawnOne,
                                    BluePawnTwo, BluePawnThree, GreenPawn, GreenPawnOne, GreenPawnTwo, GreenPawnThree, YellowPawn, 
                                    YellowPawnOne, YellowPawnTwo, YellowPawnThree}
                for(Pawns : AllPlayersPawns):
                    Pawns.Show()
                    spawn. GameStartInitiator()
            else:
                Print("Game Started")
    )

    SelectPressed(Agent:agent):void=(
        var Attempts:int = 0
        
        if(RedPlayer = option{Agent} and RedPlayerTurn = true  and ConfirmFlag = false):
            loop:
                if(Attempts >= 4):
                    break
                if (RollerForPlayer = 0 and RedFinished = false):
                    ResetAllHighlights()
                    set RedZeroHighlight.HIghlightIntensity = 20.0
                    RedPawn.SetMaterial(RedZeroHighlight)
                    set RollerForPlayer += 1
                    APHighlight.Play(Agent)
                    Print("Higlidhting Red Pawn 0")
                    break
                else if (RollerForPlayer = 1 and RedOneFinished = false):
                    ResetAllHighlights()
                    set RedOneHighlight.HIghlightIntensity = 20.0
                    RedPawnOne.SetMaterial(RedOneHighlight)
                    set RollerForPlayer += 1
                    APHighlight.Play(Agent)
                    break
                else if (RollerForPlayer = 2 and RedTwoFinished = false):
                    ResetAllHighlights()
                    set RedTwoHighlight.HIghlightIntensity = 20.0
                    RedPawnTwo.SetMaterial(RedTwoHighlight)
                    set RollerForPlayer += 1
                    APHighlight.Play(Agent)
                    break
                else if ( RollerForPlayer = 3 and RedThreeFinished = false):
                    ResetAllHighlights()
                    set RedThreeHighlight.HIghlightIntensity = 20.0
                    RedPawnThree.SetMaterial(RedThreeHighlight)
                    set RollerForPlayer = 0
                    APHighlight.Play(Agent)
                    break
                else:
                    if(RollerForPlayer = 0 and RedFinished = true):
                        set RollerForPlayer = 1
                    else if(RollerForPlayer = 1 and RedOneFinished = true):
                        set RollerForPlayer = 2
                    else if(RollerForPlayer = 2 and RedTwoFinished = true):
                        set RollerForPlayer = 3
                    else if(RollerForPlayer = 3 and RedThreeFinished = true):
                        set RollerForPlayer = 0
                    set Attempts += 1     
    )

