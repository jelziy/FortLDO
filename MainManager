    MovePawnRed(Pawn:creative_prop, Index:int)<suspends>:void= (
        var CurrentIndex : int = Index
        PawnTransform := Pawn.GetTransform()
        PawnZ := PawnTransform.Translation.Z
        
        if(CurrentIndex = -1 and DiceRollValue = 6):
            if(Path := RedPaths[0]):
                PathTransform:= Path.GetTransform()
                PathTranslation:= PathTransform.Translation
                NewPos := vector3{X := PathTranslation.X, Y := PathTranslation.Y, Z := PawnZ}
                if(Pawn.TeleportTo[NewPos, PawnTransform.Rotation]):
                    set CurrentIndex = 0
                    set DiceRollValue = 0

        else if(CurrentIndex >= 0):
            Print("Stepwise movement, starting at index {CurrentIndex}")
            TargetIndex := CurrentIndex + DiceRollValue
            if(TargetIndex < RedPaths.Length):
                for (Step := 1..DiceRollValue):
                    NextIndex := CurrentIndex + 1
                    Print("Step {Step}: NextIndex = {NextIndex}")
                    if(Path := RedPaths[NextIndex]):
                        PathTransform := Path.GetTransform()
                        PathTranslation := PathTransform.Translation
                        NewPos := vector3{X := PathTranslation.X, Y := PathTranslation.Y, Z := PawnZ}
                        if(Pawn.TeleportTo[NewPos, PawnTransform.Rotation]):
                            set CurrentIndex = NextIndex
                            set DiceRollValue = 0
                            Sleep(0.2)

        if (RedZeroHighlight.HIghlightIntensity = 20.0):
            set RedPawnIndex = CurrentIndex
        else if (RedOneHighlight.HIghlightIntensity = 20.0):
            set RedPawnOneIndex = CurrentIndex
        else if (RedTwoHighlight.HIghlightIntensity = 20.0):
            set RedPawnTwoIndex = CurrentIndex
        else if (RedThreeHighlight.HIghlightIntensity = 20.0):
            set RedPawnThreeIndex = CurrentIndex

        ResetAllHighlights()     
    )

