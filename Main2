    GameStartInitiator():void=(
        var PlayerCount : int = 0
        if(RedPlayer?):
            set PlayerCount += 1
        if(BluePlayer?):
            set PlayerCount += 1
        if(YellowPlayer?):
            set PlayerCount += 1
        if(GreenPlayer?):
            set PlayerCount += 1
        
        if(OnePlayerSwitch.GetCurrentState[]):
            if(PlayerCount = 1):
                set GameStarted = true
                set RedPlayerTurn = true
                set ActivePlayerCount = PlayerCount
                spawn{HelperPlayerProfileTurn()}
        if(TwoPlayerSwitch.GetCurrentState[]):
            if(PlayerCount = 2):
                set GameStarted = true
                set RedPlayerTurn = true
                set ActivePlayerCount = PlayerCount
                spawn{HelperPlayerProfileTurn()}

        else if(ThreePlayerSwitch.GetCurrentState[]):
            if(PlayerCount = 3):
                set GameStarted = true
                set RedPlayerTurn = true
                set ActivePlayerCount = PlayerCount
                spawn{HelperPlayerProfileTurn()}

        else if(FourPlayerSwitch.GetCurrentState[]):
            if(PlayerCount = 4):
                set GameStarted = true
                set RedPlayerTurn = true
                set ActivePlayerCount = PlayerCount
                spawn{HelperPlayerProfileTurn()}
    )

    RedOneJoined(Agent : agent) : void = (
        if(RedPlayer = false):
            RedCamera.AddTo(Agent)   #just to check hash
            set RedPlayer = option{Agent}
            RedChair.DisableExit()
            if(GameStarted = false):
                set AllRedPawn = array{RedPawn, RedPawnOne, RedPawnTwo, RedPawnThree}
                for(RedPawnForRedJoined : AllRedPawn):
                    RedPawnForRedJoined.Show()
                    GameStartInitiator()
            else if(GameStarted = true):
                Print("Game has already started. You cannot join now.")
    )

