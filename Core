    ExitingTheArena(Agent:agent):void=(

        if(RedPlayer = option{Agent}):
            set RedPlayer = false
            spawn{LeaveWidget(Agent)}           
            RedCamera.RemoveFrom(Agent)
            RedCamera.Disable()
            RedChair.EnableExit()
            if(RedPawn.TeleportTo[RedPawnInitialTransform]):
            if(RedPawnOne.TeleportTo[RedPawnOneInitialTransform]): 
            if(RedPawnTwo.TeleportTo[RedPawnTwoInitialTransform]): 
            if(RedPawnThree.TeleportTo[RedPawnThreeInitialTransform]):
            set AllRedPawn = array{RedPawn, RedPawnOne, RedPawnTwo, RedPawnThree}
            for(Pawns : AllRedPawn):
                Pawns.Hide()
            RedIndexInitialSetter()
            if(not FinishedOrder.Find[0]):
                set ActivePlayerCount -= 1

            set RedPlayerIcon.TexParam = NormAv
            RedAvProp.SetMaterial(RedPlayerIcon)

            RedTp2.Teleport(Agent)
            RedPr.Clear()
            
            

        else if(BluePlayer = option{Agent}):
            set BluePlayer = false # for PlayTesting.... was "#"# there not now
