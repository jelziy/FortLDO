            GreenChair.Seat(GreenAgent)
            GreenChair.DisableExit

        RedPr.Clear()
        BluePr.Clear()
        GreenPr.Clear()
        YellowPr.Clear()

        
    RedOneJoined(Agent : agent) : void = (

        if(RedPlayer = false and GameStarted = false):
            if:
                option{Agent} <> BluePlayer
                option{Agent} <> YellowPlayer
                option{Agent} <> GreenPlayer
            then:
                #spawn{LoadWidget(Agent)}
                #RedCamera.AddTo(Agent)   #just to check hash
                set RedPlayer = option{Agent}
                RedChair.DisableExit()
                RedPr.Register(Agent)
                if:
                    FcIcon := Agent.GetFortCharacter[].GetEntity[].GetComponent[icon_component].Icon
                    Player := player[Agent]
                then:
                    set RedPlayerIcon.TexParam = FcIcon
                    RedAvProp.SetMaterial(RedPlayerIcon)
                
                if(GameStarted = false):
                    set AllRedPawn = array{RedPawn, RedPawnOne, RedPawnTwo, RedPawnThree}
                    for(RedPawnForRedJoined : AllRedPawn):
                        RedPawnForRedJoined.Show()
                        spawn{GameStartInitiator()}
                else if(GameStarted = true):
                    Print("Game has already started. You cannot join now.")
    )

