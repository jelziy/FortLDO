    #in main code diceprop is for 0 dice and 1 is for the blinking thing , i want to seperate but will do later..

#This is for player version but can be used for ai version
shared_game_data<public> := class<concrete>:

    @editable Device : devices_group = devices_group{}

    @editable Pns : pawns_group = pawns_group{}

    #player state
    var Player : ?agent = false
    var TempPlayer : ?agent = false
    var IsTurn : logic = false

    #Dice/turn state
    var DiceRollValue : int = 0
    var ConsecutiveSixes : int = 0
    var Roller : int = 0
    var DoubleRollFlag : logic = false

    #positions
    var PawnIndex : int = -1
    var PawnOneIndex : int = -1
    var PawnTwoIndex : int = -1
    var PawnThreeIndex : int = -1

    # Initial transforms 
    var PawnInitialTransform : transform = transform{}
    var PawnOneInitialTransform : transform = transform{}
    var PawnTwoInitialTransform : transform = transform{}
    var PawnThreeInitialTransform : transform = transform{}

    #finish state
    var PawnFinished : logic = false
    var PawnOneFinished : logic = false
    var PawnTwoFinished : logic = false
    var PawnThreeFinished : logic = false

    var FinishedPawnCount : int = 0

    # Provides an array only when all four pawns need the same operation.
    GetPawn():[]creative_prop=
        array{Pns.Pawn, Pns.PawnOne, Pns.PawnTwo, Pns.PawnThree}

    CaptureInitialTransforms():void=
        set PawnInitialTransform = Pns.Pawn.GetTransform()
        set PawnOneInitialTransform = Pns.PawnOne.GetTransform()
        set PawnTwoInitialTransform = Pns.PawnTwo.GetTransform()
        set PawnThreeInitialTransform = Pns.PawnThree.GetTransform()

    GetTransforms():[]transform=
        array{PawnInitialTransform, PawnOneInitialTransform, PawnTwoInitialTransform, PawnThreeInitialTransform}

    GetIndex():[]int= 
        array{PawnIndex, PawnOneIndex, PawnTwoIndex, PawnThreeIndex}

    ResetPawnState():void=
        HidePawns()

        if(Pns.Pawn.TeleportTo[PawnInitialTransform]):
        if(Pns.PawnOne.TeleportTo[PawnOneInitialTransform]):
        if(Pns.PawnTwo.TeleportTo[PawnTwoInitialTransform]):
        if(Pns.PawnTwo.TeleportTo[PawnThreeInitialTransform]):

        set PawnIndex = -1
        set PawnOneIndex = -1
        set PawnTwoIndex = -1
        set PawnThreeIndex = -1
        
        set PawnFinished = false
        set PawnOneFinished = false
        set PawnTwoFinished = false
        set PawnThreeFinished = false

        set FinishedPawnCount = 0

    HidePawns():void=
        Pns.Pawn.Hide()
        Pns.PawnOne.Hide()
        Pns.PawnTwo.Hide()
        Pns.PawnThree.Hide()

    ResetTurnState():void= #or can be useful in turn change
        set IsTurn = false
        set DiceRollValue = 0
        set ConsecutiveSixes = 0
        set Roller = 0   #maybe not
        set DoubleRollFlag = false

    ClearPlayers():void= #only do when left and game reset 
        set Player = false
        set TempPlayer = false

    ResetRuntimeState():void=
        ResetPawnState()
        ResetTurnState()
        ClearPlayers()
    

    
    
