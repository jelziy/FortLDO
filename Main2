            ResetAllHighlights(Agent)
            set RedZeroHighlight.HIghlightIntensity = 20.0
            RedPawn.SetMaterial(RedZeroHighlight)
            set RollerForRed += 1
            Print("Higlidhting Red Pawn 0")
        else if (RedPlayer = option{Agent} and RedPlayerTurn = true and RollerForRed = 1):
            ResetAllHighlights(Agent)
            set RedOneHighlight.HIghlightIntensity = 20.0
            RedPawnOne.SetMaterial(RedOneHighlight)
            set RollerForRed += 1
        else if (RedPlayer = option{Agent} and RedPlayerTurn = true and RollerForRed = 2):
            ResetAllHighlights(Agent)
            set RedTwoHighlight.HIghlightIntensity = 20.0
            RedPawnTwo.SetMaterial(RedTwoHighlight)
            set RollerForRed += 1
