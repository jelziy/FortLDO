                set RedDiceRollValue = RollValue
                if(DiceProp := RedDiceProp[0]):
                    DiceProp.SetMaterial(RollingDice)
                    spawn{HelperDiceRoll(Agent)}
                    spawn{PossibleMoveChecker(Agent)}
