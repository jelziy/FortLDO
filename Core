    MovePawnRed(Pawn:creative_prop, Index:int, Agent:agent, PawnNumber : int)<suspends>:void= ( #mentioned in confirm input pressed function
        var CurrentIndex : int = Index
        PawnTransform := Pawn.GetTransform()
        PawnZ := PawnTransform.Translation.Z
        var MoveCompleted : logic = false
        var ThirdSix : logic = false
        var KeepTurn : logic = false

        if(CurrentIndex = -1 and Red.DiceRollValue = 6):
            if(Path := Red.Pns.Paths[0]):
                PathTransform:= Path.GetTransform()
                PathTranslation:= PathTransform.Translation
                NewPos := vector3{X := PathTranslation.X, Y := PathTranslation.Y, Z := PawnZ}
                AudioPlayerMain(General.Audio.Move)
                if(Pawn.TeleportTo[NewPos, PawnTransform.Rotation]):
                    set CurrentIndex = 0
                    set MoveCompleted = true


        else if(CurrentIndex >= 0):
            Print("Stepwise movement, starting at index {CurrentIndex}")
            TargetIndex := CurrentIndex + Red.DiceRollValue
            RemainingPaths := Red.Pns.Paths.Length - CurrentIndex - 1
            if(Red.DiceRollValue <= RemainingPaths):
                if(TargetIndex < Red.Pns.Paths.Length):
                    for (Step := 1..Red.DiceRollValue):
                        NextIndex := CurrentIndex + Step
                        Print("Step {Step}: NextIndex = {NextIndex}")
                        if(Path := Red.Pns.Paths[NextIndex]):
                            PathTransform := Path.GetTransform()
                            PathTranslation := PathTransform.Translation
                            NewPos := vector3{X := PathTranslation.X, Y := PathTranslation.Y, Z := PawnZ}
                            AudioPlayerMain(General.Audio.Move)
                            if(Pawn.TeleportTo[NewPos, PawnTransform.Rotation]):
                                Sleep(0.4)
                    set CurrentIndex = TargetIndex
                    set MoveCompleted = true

            else:
                Print("Not enough remaining path for the dice roll. Move is invalid.")

        if(MoveCompleted = true):
            if (PawnNumber = 0):
                set Red.PawnIndex = CurrentIndex
            else if (PawnNumber = 1):
                set Red.PawnOneIndex = CurrentIndex
            else if (PawnNumber = 2):
                set Red.PawnTwoIndex = CurrentIndex
            else if (PawnNumber = 3):
                set Red.PawnThreeIndex = CurrentIndex

            if(Red.DiceRollValue = 6):
                set Red.ConsecutiveSixes += 1
            
                if(Red.ConsecutiveSixes >= 3):
                    set ThirdSix = true
                    set Red.ConsecutiveSixes = 0
            else:
                set Red.ConsecutiveSixes = 0

            Eliminated := PossibleElimChecker(CurrentIndex, PawnNumber, 0, Agent)

            if(ThirdSix = true):
                set KeepTurn = false
            else if(Eliminated = true or Red.DiceRollValue = 6):
                set KeepTurn = true

            set Red.DiceRollValue = 0
            set Red.DoubleRollFlag = false
            TurnChanger(1, KeepTurn)
        
        ResetAllHighlights(Agent)
        TimerCheckerHelper()
    )

