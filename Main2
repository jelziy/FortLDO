        var BluePawnIndices : []int = array{BluePawnIndex, BluePawnOneIndex, BluePawnTwoIndex, BluePawnThreeIndex}
        var YellowPawnIndices : []int = array{YellowPawnIndex, YellowPawnOneIndex, YellowPawnTwoIndex, YellowPawnThreeIndex}
        var GreenPawnIndices : []int = array{GreenPawnIndex, GreenPawnOneIndex, GreenPawnTwoIndex, GreenPawnThreeIndex}
        
        RedPawnTransforms : []transform = array{RedPawnInitialTransform, RedPawnOneInitialTransform, RedPawnTwoInitialTransform, RedPawnThreeInitialTransform}
        BluePawnTransforms : []transform = array{BluePawnInitialTransform, BluePawnOneInitialTransform, BluePawnTwoInitialTransform, BluePawnThreeInitialTransform}
        YellowPawnTransforms : []transform = array{YellowPawnInitialTransform, YellowPawnOneInitialTransform, YellowPawnTwoInitialTransform, YellowPawnThreeInitialTransform}
        GreenPawnTransforms : []transform = array{GreenPawnInitialTransform, GreenPawnOneInitialTransform, GreenPawnTwoInitialTransform, GreenPawnThreeInitialTransform}

        SafeSpots : []int = array{0, 8, 13, 21, 26, 34, 39, 47}

        var DynamicOffset : []int = array{}

        OffsetResToRed :[]int = array{0, 13, 26, 39} # 1 - Red , 2 - Blue , 3, - Yellow, 4 - Green. Positions
        OffsetResToBlue :[]int = array{39, 0, 13, 26}
        OffsetResToYellow :[]int = array{26, 39, 0, 13}
        OffsetResToGreen :[]int = array{13, 26, 39, 0}

        var EliminationOccured :logic = false

        if(Color = 0): # red
            set DynamicOffset = OffsetResToRed
        else if(Color = 1): # Blue
            set DynamicOffset = OffsetResToBlue
        else if(Color = 2): #Yellow
            set DynamicOffset = OffsetResToYellow
        else if(Color = 3): # Green
            set DynamicOffset = OffsetResToGreen
        
        #Will optimize later for target offset relative to each other. if possible # could we do FInd for searching idk.
        #Formula newIndex=(index−targetOffset+52)mod52
        #for ELim
        #there could be that it eliminate all pawn so account for that
        if(Color = 1 or Color = 2 or Color = 3 and not SafeSpots.Find[PawnPosition]): # for red
