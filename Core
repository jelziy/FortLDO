    CheckTimerForRed()<suspends>:void=(
        
        var StartTime: float = GetSimulationElapsedTime()
        loop:
            Sleep(0.2)
            if(Red.IsTurn = false):
                return
            var Elapsed : float = GetSimulationElapsedTime() - StartTime
            #Print("Timer {Elapsed}")
            if(Elapsed >= CoolDownTime):
                Print("Time Out! Moving to next player.")
                set Red.IsTurn = false
                if(Blue.Player?):
                    set Blue.IsTurn = true
                else if(Yellow.Player?):
                    set Yellow.IsTurn = true
                else if(Green.Player?):
                    set Green.IsTurn = true
                FalsingDoubleRollFlags()
                set Red.ConsecutiveSixes = 0
                spawn{HelperPlayerProfileTurn()}
                TimerCheckerHelper()
                return

            else if(Red.Player = false):
                set Red.IsTurn = false
                if(Blue.Player?):
                    set Blue.IsTurn = true
                else if(Yellow.Player?):
                    set Yellow.IsTurn = true
                else if(Green.Player?):
                    set Green.IsTurn = true
                FalsingDoubleRollFlags()
                set Red.ConsecutiveSixes = 0
                spawn{HelperPlayerProfileTurn()}
                TimerCheckerHelper()

                return
    )

